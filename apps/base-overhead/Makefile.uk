$(eval $(call addlib,appbaseoverhead))
# Default: full ablation (Part A/B/C/D). For iso-path-only microbench (paper ≈7%):
#   APPBASEOVERHEAD_SRCS-y += $(APPBASEOVERHEAD_BASE)/iso_path_microbench.c
APPBASEOVERHEAD_SRCS-y += $(APPBASEOVERHEAD_BASE)/cross_domain_ablation.c
APPBASEOVERHEAD_SRCS-y += $(APPBASEOVERHEAD_BASE)/helper/fabric_init.c
APPBASEOVERHEAD_SRCS-y += $(APPBASEOVERHEAD_BASE)/helper/register_all.c
APPBASEOVERHEAD_CINCLUDES-y += -I$(APPBASEOVERHEAD_BASE)/helper
APPBASEOVERHEAD_CINCLUDES-y += -I$(UK_BASE)/lib/fabric-core/overhead/include
LDFLAGS-y += -Wl,--defsym=_fabric_comp1_fabric_2_data_start=0x1b4348 -Wl,--defsym=_fabric_comp1_fabric_2_data_end=0x1b434c -Wl,--defsym=_fabric_comp1_fabric_2_bss_start=0x0 -Wl,--defsym=_fabric_comp1_fabric_2_bss_end=0x0 -Wl,--defsym=_fabric_comp1_fabric_2_text_start=0x19b2b0 -Wl,--defsym=_fabric_comp1_fabric_2_text_end=0x19b2e5 -Wl,--defsym=_fabric_comp1_fabric_3_data_start=0x0 -Wl,--defsym=_fabric_comp1_fabric_3_data_end=0x0 -Wl,--defsym=_fabric_comp1_fabric_3_bss_start=0x0 -Wl,--defsym=_fabric_comp1_fabric_3_bss_end=0x0 -Wl,--defsym=_fabric_comp1_fabric_3_text_start=0x19b2f0 -Wl,--defsym=_fabric_comp1_fabric_3_text_end=0x19b315 -Wl,--defsym=_fabric_comp1_fabric_4_data_start=0x0 -Wl,--defsym=_fabric_comp1_fabric_4_data_end=0x0 -Wl,--defsym=_fabric_comp1_fabric_4_bss_start=0x0 -Wl,--defsym=_fabric_comp1_fabric_4_bss_end=0x0 -Wl,--defsym=_fabric_comp1_fabric_4_text_start=0x19b320 -Wl,--defsym=_fabric_comp1_fabric_4_text_end=0x19b335 -Wl,--defsym=_fabric_comp1_fabric_5_data_start=0x0 -Wl,--defsym=_fabric_comp1_fabric_5_data_end=0x0 -Wl,--defsym=_fabric_comp1_fabric_5_bss_start=0x0 -Wl,--defsym=_fabric_comp1_fabric_5_bss_end=0x0 -Wl,--defsym=_fabric_comp1_fabric_5_text_start=0x19b340 -Wl,--defsym=_fabric_comp1_fabric_5_text_end=0x19b341
