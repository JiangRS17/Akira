+    /*
+     * VMEPT: Comp1 select is non-blocking (selscan only). Sleep on Comp0 so
+     * the Comp1 RPC thread is never held across a wait — that deadlocked wrk.
+     * Also rate-limit sticky ready>0 (level-trigger spin after close/FIN).
+     */
+    {
+        ngx_msec_t         remaining = timer;
+        ngx_msec_t         slice;
+        static unsigned    ready_streak;
+
+        for (;;) {
+            work_read_fd_set = master_read_fd_set;
+            work_write_fd_set = master_write_fd_set;
+
+            ngx_ept_select_tv.tv_sec = 0;
+            ngx_ept_select_tv.tv_usec = 0;
+
+            flexos_vmept_gate_r(FLEXOS_VMEPT_APPCOMP, FLEXOS_VMEPT_LWIP_COMP, ready, select, max_fd + 1,
+                               &work_read_fd_set, &work_write_fd_set, NULL,
+                               &ngx_ept_select_tv);
+
+            if (ready != 0) {
+                if (++ready_streak > 32) {
+                    uk_sched_thread_sleep(ukarch_time_msec_to_nsec(1));
+                    ready_streak = 0;
+                }
+                break;
+            }
+
+            ready_streak = 0;
+
+            if (timer != NGX_TIMER_INFINITE) {
+                if (remaining == 0) {
+                    break;
+                }
+                slice = (remaining < 5) ? remaining : 5;
+                remaining -= slice;
+            } else {
+                slice = 5;
+            }
+
+            uk_sched_thread_sleep(ukarch_time_msec_to_nsec(slice));
+        }
+    }
 
