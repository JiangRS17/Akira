$(eval $(call addlib_s,libexample1,$(CONFIG_LIBEXAMPLE1)))

CINCLUDES-$(CONFIG_LIBEXAMPLE1) += -I$(LIBEXAMPLE1_BASE)/include
CXXINCLUDES-$(CONFIG_LIBEXAMPLE1) += -I$(LIBEXAMPLE1_BASE)/include

LIBEXAMPLE1_SRCS-y += $(LIBEXAMPLE1_BASE)/example1.c
LIBEXAMPLE1_LDFLAGS-y += -Wl,-T,$(LIBEXAMPLE1_BASE)/flexos_extra.ld